# Groq API keys (get from https://console.groq.com)
GROQ_API_KEY_MAIN=gsk_your_main_key_here
GROQ_API_KEY_SUMMARY=gsk_your_summary_key_here

# Hindsight / Vectorize (get from https://hindsight.vectorize.io)
HINDSIGHT_API_KEY=your_hindsight_key_here
HINDSIGHT_URL=https://api.hindsight.vectorize.io
BANK_ID=meeting-intelligence

# Model names (check Groq docs for current valid names)
MODEL_TRANSCRIBE=whisper-large-v3-turbo
MODEL_CORRECT=qwen/qwen3-32b
MODEL_EXTRACT=openai/gpt-oss-120b
MODEL_SUMMARY=llama-3.3-70b-versatile
MODEL_BRIEF=llama-3.3-70b-versatile
